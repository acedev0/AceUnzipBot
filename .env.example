# Required — get API_ID and API_HASH from https://my.telegram.org
API_ID=123456
API_HASH=replace_with_your_32_character_api_hash
BOT_TOKEN=replace_with_your_botfather_token
OWNER_ID=123456789

# Optional and failure-safe. Leave blank for no log delivery.
# The owner can set/test/disable this later from /admin. If configured, add the bot
# as an administrator; an inaccessible channel never stops archive jobs.
LOG_CHANNEL_ID=

# Advanced paths. Relative paths are resolved from the project directory.
DATA_DIR=./data
WORK_DIR=./work
LOG_LEVEL=INFO
